NODE_ENV=development
PORT=8080
APP_VERSION=0.0.0
DATABASE_URL=postgresql://habituar_app:habituar_app@localhost:5433/habituar
DATABASE_MIGRATION_URL=postgresql://habituar_owner:habituar_owner@localhost:5433/habituar
LOG_LEVEL=info

# Seeds. Sem ADMIN_PASSWORD definida, o seed de admin gera uma senha e a imprime uma
# única vez. DEV_SEED_PASSWORD é a senha compartilhada dos usuários de desenvolvimento e
# só existe fora de produção.
ADMIN_EMAIL=admin@habituar.dev
ADMIN_INSTITUTION_NAME=Instituição Padrão
DEV_SEED_PASSWORD=habituar-dev
