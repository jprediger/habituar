{
  "name": "@habituar/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js"
    },
    "./semantic-color": {
      "types": "./dist/semantic-color.d.ts",
      "import": "./dist/semantic-color.js"
    },
    "./spacing": {
      "types": "./dist/spacing.d.ts",
      "import": "./dist/spacing.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "import": "./dist/contrast.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsup && node --experimental-strip-types scripts/write-theme-css.ts",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@habituar/config": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
