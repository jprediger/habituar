{
  "name": "habituar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "lint": "turbo run lint",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "check:affected": "turbo run lint typecheck test --affected",
    "test:boundaries": "pnpm --filter @habituar/config test",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "22.20.1",
    "husky": "9.1.7",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  }
}
