# Copie para `.env.live` (não versionado) e preencha. Usado só pelo `compose.live.yml`.

# Domínio estático gratuito da conta ngrok (dashboard.ngrok.com → Domains), sem `https://`.
NGROK_DOMAIN=
# dashboard.ngrok.com → Your Authtoken
NGROK_AUTHTOKEN=

# Superusuário do Postgres deste ambiente. Os papéis da aplicação vêm do bootstrap.sql.
POSTGRES_PASSWORD=
# Senha do admin e de todos os usuários de exemplo. Este ambiente é público: não reaproveite
# a senha do `.env.example`.
DEV_SEED_PASSWORD=

# Opcionais
# APP_VERSION=0.0.0-live
# LOG_LEVEL=info
# API_HOST_PORT=8090
